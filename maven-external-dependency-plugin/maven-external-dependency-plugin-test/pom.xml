<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
<modelVersion>4.0.0</modelVersion>
<groupId>org.openidentityplatform.commons</groupId>
<artifactId>maven-external-dependency-plugin-test</artifactId>
<packaging>jar</packaging>
<version>3.0.5-SNAPSHOT</version>
<name>${project.groupId}.${project.artifactId}</name>
<url>https://github.com/OpenIdentityPlatform/commons/tree/master/maven-external-dependency-plugin</url>

    <!-- BUILD PROPERTIES -->
    <properties>
        <!-- PROJECT ENCODING PROPERTIES -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Staging directory where external artifacts are downloaded before install -->
        <staging.directory>${project.build.directory}/dependencies/</staging.directory>
    </properties>

<build>
<finalName>${project.groupId}.${project.artifactId}</finalName>
<extensions>
<extension>
<!-- Support HTTP redirects during artifact download -->
<groupId>org.apache.maven.wagon</groupId>
<artifactId>wagon-http-lightweight</artifactId>
<version>3.4.3</version>
</extension>
</extensions>
<plugins>

<!-- JAVA PROJECT COMPILER -->

<plugin>
<artifactId>maven-compiler-plugin</artifactId>
<configuration>
<source>11</source>
<target>11</target>
</configuration>
</plugin>

<!-- TEST RUNNER: pass the staging directory path as a system property
     so that unit tests can verify downloaded artifacts -->

<plugin>
<artifactId>maven-surefire-plugin</artifactId>
<version>2.22.2</version>
<configuration>
<systemPropertyVariables>
<staging.directory>${staging.directory}</staging.directory>
</systemPropertyVariables>
</configuration>
</plugin>

<!-- EXTERNAL DEPENDENCY RESOLVER
     This plugin downloads, installs, and deploys artifacts that are
     not available in any Maven repository.

     Goals:
       resolve-external  - download artifacts to the staging directory
       install-external  - install staged artifacts into the local repo
       deploy-external   - deploy staged artifacts to a remote repo
       clean-external    - remove staged artifacts from the staging directory

     Full command examples:
       mvn org.openidentityplatform.commons:maven-external-dependency-plugin:resolve-external
       mvn org.openidentityplatform.commons:maven-external-dependency-plugin:install-external
       mvn org.openidentityplatform.commons:maven-external-dependency-plugin:deploy-external
       mvn org.openidentityplatform.commons:maven-external-dependency-plugin:clean-external
-->

<plugin>
<groupId>org.openidentityplatform.commons</groupId>
<artifactId>maven-external-dependency-plugin</artifactId>
<version>3.0.5-SNAPSHOT</version>
<inherited>false</inherited>
<configuration>
<stagingDirectory>${staging.directory}</stagingDirectory>
<!-- Create MD5 and SHA-1 checksums for installed artifacts -->
<createChecksum>true</createChecksum>
<!-- Set to true to skip checksum verification on downloads -->
<skipChecksumVerification>false</skipChecksumVerification>
<!-- Set to true to force re-download even if already installed -->
<force>false</force>
<artifactItems>

<!-- ============================================================
     EXAMPLE 1: Basic JAR download using URL template variables.
     Supported tokens: {groupId}, {artifactId}, {version},
                       {packaging}, {classifier}, {type}, {_version}
     ({_version} replaces dots with underscores, e.g. 2_11_0)
     ============================================================ -->
<artifactItem>
<groupId>commons-io</groupId>
<artifactId>commons-io</artifactId>
<version>2.11.0</version>
<packaging>jar</packaging>
<downloadUrl>https://repo1.maven.org/maven2/commons-io/commons-io/{version}/{artifactId}-{version}.{packaging}</downloadUrl>
<install>true</install>
<generatePom>true</generatePom>
<!-- Skip Sonatype checksum lookup for this well-known artifact -->
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>

<!-- ============================================================
     EXAMPLE 2: JAR download with explicit SHA-1 checksum
     verification and a custom download timeout (milliseconds).
     The plugin verifies <checksum> against the downloaded file
     before installing it.
     ============================================================ -->
<artifactItem>
<groupId>org.hamcrest</groupId>
<artifactId>hamcrest-core</artifactId>
<version>1.3</version>
<packaging>jar</packaging>
<downloadUrl>https://repo1.maven.org/maven2/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar</downloadUrl>
<checksum>42a25dc3219429f0e5d060061f71acb49bf010a0</checksum>
<skipChecksumVerification>false</skipChecksumVerification>
<!-- Timeout in milliseconds (default: 5000) -->
<timeout>30000</timeout>
<install>true</install>
<generatePom>true</generatePom>
</artifactItem>

<!-- ============================================================
     EXAMPLE 3: Download to staging only - skip local install
     and remote deploy.  Useful for inspecting the artifact
     before committing to a full install.
     ============================================================ -->
<artifactItem>
<groupId>org.slf4j</groupId>
<artifactId>slf4j-api</artifactId>
<version>1.7.36</version>
<packaging>jar</packaging>
<downloadUrl>https://repo1.maven.org/maven2/org/slf4j/slf4j-api/1.7.36/slf4j-api-1.7.36.jar</downloadUrl>
<install>false</install>
<deploy>false</deploy>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>

<!-- ============================================================
     EXAMPLE 4: JAR with a classifier (e.g. sources, javadoc,
     tests).  The {classifier} token is substituted in both
     <downloadUrl> and <localFile>.
     ============================================================ -->
<artifactItem>
<groupId>commons-lang</groupId>
<artifactId>commons-lang</artifactId>
<version>2.6</version>
<classifier>sources</classifier>
<packaging>jar</packaging>
<downloadUrl>https://repo1.maven.org/maven2/commons-lang/commons-lang/{version}/{artifactId}-{version}-{classifier}.{packaging}</downloadUrl>
<install>true</install>
<!-- Do not auto-generate a POM; let the existing one be used -->
<generatePom>false</generatePom>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>

<!-- ============================================================
     EXAMPLE 5: Extract a specific entry from a ZIP archive.
     <extractFile> is the path inside the ZIP to the desired
     artifact; token substitution applies here too.
     ============================================================ -->
<!--
<artifactItem>
<groupId>org.apache.ant</groupId>
<artifactId>ant</artifactId>
<version>1.10.14</version>
<packaging>jar</packaging>
<downloadUrl>https://archive.apache.org/dist/ant/binaries/apache-ant-{version}-bin.zip</downloadUrl>
<extractFile>apache-ant-{version}/lib/{artifactId}.{packaging}</extractFile>
<install>true</install>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>
-->

<!-- ============================================================
     EXAMPLE 6: Extract a file from a tar.gz archive.
     Supported archive formats for extraction:
       zip, tar, tar.gz, tgz, tar.bz2, tbz2, gz, bz2
     ============================================================ -->
<!--
<artifactItem>
<groupId>org.apache.commons</groupId>
<artifactId>commons-lang3</artifactId>
<version>3.12.0</version>
<packaging>jar</packaging>
<downloadUrl>https://archive.apache.org/dist/commons/lang/binaries/commons-lang3-{version}-bin.tar.gz</downloadUrl>
<extractFile>commons-lang3-{version}/commons-lang3-{version}.{packaging}</extractFile>
<install>true</install>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>
-->

<!-- ============================================================
     EXAMPLE 7: Force re-download on every build.
     Set <force>true</force> to bypass the "already installed"
     check and always download, install, and deploy.
     ============================================================ -->
<!--
<artifactItem>
<groupId>com.example</groupId>
<artifactId>my-library</artifactId>
<version>1.0.0</version>
<packaging>jar</packaging>
<downloadUrl>http://example.com/path/to/{artifactId}-{version}.{packaging}</downloadUrl>
<force>true</force>
<install>true</install>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>
-->

<!-- ============================================================
     EXAMPLE 8: Use a hand-crafted POM file during installation
     instead of generating a minimal one automatically.
     Set <generatePom>false</generatePom> when providing your own.
     ============================================================ -->
<!--
<artifactItem>
<groupId>com.example</groupId>
<artifactId>proprietary-lib</artifactId>
<version>2.0.0</version>
<packaging>jar</packaging>
<downloadUrl>http://example.com/proprietary-lib-{version}.{packaging}</downloadUrl>
<pomFile>${basedir}/src/main/pom/proprietary-lib-2.0.0.pom</pomFile>
<generatePom>false</generatePom>
<install>true</install>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>
-->

<!-- ============================================================
     EXAMPLE 9: Independent checksums for the downloaded archive
     and the file extracted from it.
     <checksum>            - SHA-1 of the downloaded ZIP/archive
     <extractFileChecksum> - SHA-1 of the extracted artifact file
     ============================================================ -->
<!--
<artifactItem>
<groupId>de.innosystec</groupId>
<artifactId>java-unrar</artifactId>
<version>0.5</version>
<packaging>jar</packaging>
<downloadUrl>https://github.com/downloads/edmund-wagner/junrar/java-unrar-{version}.zip</downloadUrl>
<checksum>2C55D845394FAA6A6B5C2C477E280BC50D73DF32</checksum>
<extractFile>java-unrar/java-unrar-{version}.jar</extractFile>
<extractFileChecksum>111074096B6BDCE79FA09842143C336A5CF64FCB</extractFileChecksum>
<install>true</install>
<force>false</force>
</artifactItem>
-->

<!-- ============================================================
     EXAMPLE 10: Repack a directory extracted from an archive
     back into a new JAR/ZIP artifact.
     Set <repack>true</repack> to trigger the repack behaviour.
     ============================================================ -->
<!--
<artifactItem>
<groupId>com.example</groupId>
<artifactId>repacked-lib</artifactId>
<version>1.0.0</version>
<packaging>jar</packaging>
<downloadUrl>http://example.com/repacked-lib-{version}-dist.zip</downloadUrl>
<extractFile>repacked-lib-{version}/</extractFile>
<repack>true</repack>
<install>true</install>
<skipChecksumVerification>true</skipChecksumVerification>
</artifactItem>
-->

</artifactItems>

</configuration>
<executions>
<execution>
<id>clean-external-dependencies</id>
<phase>clean</phase>
<goals>
<goal>clean-external</goal>
</goals>
</execution>
<execution>
<id>resolve-install-external-dependencies</id>
<phase>process-resources</phase>
<goals>
<goal>resolve-external</goal>
<goal>install-external</goal>
</goals>
</execution>
<execution>
<id>deploy-external-dependencies</id>
<phase>deploy</phase>
<goals>
<goal>deploy-external</goal>
</goals>
</execution>
</executions>
</plugin>
</plugins>

<!-- IF USING THE WEBDAV PROTOCOL, THE FOLLOWING EXTENSION MAY BE REQUIRED -->
<!-- <extensions>                                                          -->
<!--   <extension>                                                         -->
<!--     <groupId>org.apache.maven.wagon</groupId>                         -->
<!--     <artifactId>wagon-webdav</artifactId>                             -->
<!--     <version>1.0-beta-2</version>                                     -->
<!--   </extension>                                                         -->
<!-- </extensions>                                                          -->

<pluginManagement>
<plugins>
<!-- Store Eclipse m2e settings; no effect on the Maven build itself. -->
<plugin>
<groupId>org.eclipse.m2e</groupId>
<artifactId>lifecycle-mapping</artifactId>
<version>1.0.0</version>
<configuration>
<lifecycleMappingMetadata>
<pluginExecutions>
<pluginExecution>
<pluginExecutionFilter>
<groupId>org.openidentityplatform.commons</groupId>
<artifactId>maven-external-dependency-plugin</artifactId>
<versionRange>[3.0.0-SNAPSHOT,)</versionRange>
<goals>
<goal>resolve-external</goal>
<goal>install-external</goal>
</goals>
</pluginExecutionFilter>
<action>
<ignore></ignore>
</action>
</pluginExecution>
</pluginExecutions>
</lifecycleMappingMetadata>
</configuration>
</plugin>
</plugins>
</pluginManagement>
</build>


<!-- PROJECT DEPENDENCIES -->

<dependencies>

<!-- Runtime dependency resolved by the external-dependency plugin above -->
<dependency>
<groupId>commons-io</groupId>
<artifactId>commons-io</artifactId>
<version>2.11.0</version>
</dependency>

<dependency>
<groupId>org.hamcrest</groupId>
<artifactId>hamcrest-core</artifactId>
<version>1.3</version>
</dependency>

<dependency>
<groupId>junit</groupId>
<artifactId>junit</artifactId>
<version>4.13.2</version>
<scope>test</scope>
</dependency>

</dependencies>
</project>
